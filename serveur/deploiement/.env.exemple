# Copier en .env sur le serveur (jamais dans un dépôt).
# Sans nom de domaine : l'IP du VPS avec des tirets + .sslip.io (HTTPS gratuit et automatique).
DOMAINE=51-83-12-34.sslip.io

# Votre clé Anthropic : elle ne quitte jamais le serveur.
ANTHROPIC_API_KEY=
# Plafond de dépense IA du mois, tous utilisateurs (dollars). Fixez aussi une limite dans console.anthropic.com.
SMARTMAIL_BUDGET_MENSUEL_USD=50
SMARTMAIL_MODELE=claude-opus-5-5

# Démonstration (faux annuaire, aucun mail envoyé). Mettre 0 en production réelle.
SMARTMAIL_DEMO=1
SMARTMAIL_FAUX_CLAUDE=0
SMARTMAIL_ORIGINES=https://51-83-12-34.sslip.io
